# =============================================================================
# MLPilot environment variables
#
# Copy this file to `.env` and adjust values as needed.
# All backend variables are read by pydantic-settings
# (backend/app/core/config.py) and are OPTIONAL — sensible defaults are used
# when a variable is omitted.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend (FastAPI / SQLAlchemy)
# -----------------------------------------------------------------------------

# Database connection string.
#   - Local dev default: SQLite file at <DATA_DIR>/mlpilot.db (no server required)
#   - PostgreSQL:        postgresql+psycopg2://user:pass@host:5432/db
# NOTE: docker-compose.yml uses "postgresql+asyncpg://..." but asyncpg is NOT
# installed (only psycopg2-binary is in requirements.txt). For Postgres use the
# psycopg2 driver shown above, or add asyncpg to requirements.txt.
# By default this is resolved to an ABSOLUTE path inside DATA_DIR so all data
# stays on the local machine regardless of where the server is launched.
DATABASE_URL=sqlite:///./data/mlpilot.db

# Enable debug mode (more verbose logging and error details).
DEBUG=true

# Allowed CORS origins. Parsed by pydantic as a JSON list.
CORS_ORIGINS=["http://localhost:5173"]

# Root directory for ALL local artifacts (datasets, models, EDA reports,
# cleaning runs, the SQLite DB, etc.). Resolved to an absolute path:
#   - if set: used as-is (relative paths resolve against the working dir)
#   - if unset: defaults to <project root>/data
# Everything the app persists lives under this directory on the user's machine.
DATA_DIR=data

# Auto-cleanup of datasets/models older than AUTO_CLEANUP_MAX_AGE_DAYS.
# Disabled by default (false) so local users keep their data indefinitely.
ENABLE_AUTO_CLEANUP=false
AUTO_CLEANUP_MAX_AGE_DAYS=7

# Maximum upload dataset size, in megabytes.
MAX_DATASET_SIZE_MB=5120

# Human-readable application name (used in the OpenAPI title).
APP_NAME=MLPilot

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------

# Base URL the frontend uses to reach the API.
# Defaults to "/api/v1", which works with both the Vite dev proxy and the
# nginx container (each forwards /api -> backend:8000). Set an absolute URL
# only when calling the backend cross-origin.
VITE_API_BASE_URL=/api/v1

# -----------------------------------------------------------------------------
# Variables NOT consumed by the current codebase — do not set them in .env:
#   SECRET_KEY           Referenced only by the (deferred) auth feature. No code
#                        reads it today, so it has no effect.
#   PYTEST_CURRENT_TEST  Injected automatically by pytest; never user-set.
# -----------------------------------------------------------------------------
