{
  "services": {
    "frontend": {
      "root": "./",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mlpilot-backend.onrender.com/api/:path*"
    },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
